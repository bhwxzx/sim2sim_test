<mujoco model="LW scene">
  <include file="LW.xml" />

  <statistic center="0 0 0.1" extent="0.8" />

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0" />
    <rgba haze="0.15 0.25 0.35 1" />
    <global azimuth="-130" elevation="-20" />
  </visual>

  <asset>
    <!-- 导入高度图数据 -->
    <hfield name="terrain_hfield" file="terrain/blind_rough_and_stairs_terrain.png" size="16.000 16.000 1.500 1.500" />
    <material name="terrain_mat" rgba="0.8 0.8 0.8 1" />
  </asset>

  <worldbody>
      <!-- 原点标记: 一个红色的球体，关闭碰撞属性(contype="0" conaffinity="0")使其仅作显示 -->
      <geom name="origin_marker" type="sphere" size="0.1" pos="0 0 0" rgba="1 0 0 1" contype="0" conaffinity="0" />

      <!-- 使用高度图生成真实起伏的地形 -->
      <geom type="hfield" hfield="terrain_hfield" material="terrain_mat" friction="1.2" solref="0.02 1.0" 
      solimp="0.9 0.95 0.001 0.5 2"  pos="0 0 -0.8"/>
  </worldbody>

</mujoco>